// Prisma schema for Workouter with NextAuth.js v5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js required models
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?       @map("email_verified")
  image         String?
  password      String?         // For credentials provider
  accounts      Account[]
  sessions      Session[]

  // User preferences
  accentColor   String          @default("coral") @map("accent_color") // coral | orange | violet
  theme         String          @default("light") // light | dark

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  // OAuth clients created by this user for API access
  oauthClients  OAuthClient[]

  @@map("users")
}

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// OAuth 2.0 clients for external API access (MCP)
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique @map("client_id")
  clientSecret String   @map("client_secret") // Hashed
  name         String   // Friendly name for the client
  description  String?
  redirectUris String[] @map("redirect_uris") // Array of allowed redirect URIs

  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Scopes this client can request
  allowedScopes String[] @map("allowed_scopes") // e.g., ["read:workouts", "write:workouts"]

  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  authorizationCodes OAuthAuthorizationCode[]
  accessTokens       OAuthAccessToken[]

  @@map("oauth_clients")
}

// OAuth authorization codes (short-lived, exchanged for tokens)
model OAuthAuthorizationCode {
  id          String   @id @default(cuid())
  code        String   @unique
  clientId    String   @map("client_id")
  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  redirectUri String   @map("redirect_uri")
  scope       String[] // Granted scopes
  expiresAt   DateTime @map("expires_at")
  used        Boolean  @default(false)

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([code])
  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

// OAuth access tokens (for API access)
model OAuthAccessToken {
  id        String   @id @default(cuid())
  token     String   @unique
  clientId  String   @map("client_id")
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  scope     String[] // Granted scopes
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([expiresAt])
  @@map("oauth_access_tokens")
}
