# =============================================================================
# Workouter — Environment Variable Reference
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env.local (or any file containing real secrets) to version
# control — it is already listed in .gitignore.
#
# Variable legend
#   [required]  The app will not start correctly without this value.
#   [optional]  A safe default is used when this variable is absent.
#   [build]     Consumed at `next build` time (e.g. by the Sentry webpack
#               plugin); must be present in the CI/CD environment that runs
#               the build, not only at runtime.
#   [server]    Available only on the server; never shipped to the browser.
#   [public]    Exposed to the browser bundle (NEXT_PUBLIC_ prefix).
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string used by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# [required] [server]
DATABASE_URL=postgresql://postgres:password@localhost:5432/workouter?schema=public


# =============================================================================
# NEXTAUTH / AUTH.JS
# =============================================================================

# Secret used to sign and encrypt NextAuth.js JWTs and session cookies.
# Generate one with: openssl rand -base64 32
# [required] [server]
AUTH_SECRET=your-auth-secret-here

# Canonical URL of the application (used by NextAuth.js for callback URLs).
# In production set this to the fully-qualified domain, e.g.:
#   NEXTAUTH_URL=https://workouter.example.com
# [optional — NextAuth.js infers it from the request in most deployments]
NEXTAUTH_URL=http://localhost:3000

# OAuth — Google
# Obtain credentials at https://console.cloud.google.com/apis/credentials
# [optional] [server]
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth — GitHub
# Obtain credentials at https://github.com/settings/developers
# [optional] [server]
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret


# =============================================================================
# GLITCHTIP / SENTRY — ERROR TRACKING
# =============================================================================
# Workouter uses the Sentry SDK pointed at a GlitchTip instance for error
# monitoring.  GlitchTip is fully Sentry-protocol compatible so all standard
# Sentry SDK features (error capture, performance tracing, session replay,
# source-map de-obfuscation) work without modification.
#
# Quick-start:
#   1. Create a project in your GlitchTip dashboard.
#   2. Copy the DSN from Project Settings → DSN.
#   3. Fill in the variables below.
#
# For local development you can leave all Sentry variables unset — the SDK
# will initialise without a DSN and simply not report any events.
# =============================================================================

# --- Runtime DSN variables ---------------------------------------------------

# DSN for the browser (client-side) Sentry SDK.
# This value is embedded in the browser bundle so it is intentionally public.
# It is also used by the /api/tunnel route to validate that forwarded envelopes
# target the correct GlitchTip host (prevents open-proxy abuse).
# Example: https://<publicKey>@app.glitchtip.com/<projectId>
# [optional] [public]
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@app.glitchtip.com/your-project-id

# DSN for the server-side and Edge runtime Sentry SDK.
# Keep this identical to NEXT_PUBLIC_SENTRY_DSN unless your GlitchTip setup
# uses separate projects for client vs. server events.
# This variable is NEVER shipped to the browser bundle.
# Example: https://<publicKey>@app.glitchtip.com/<projectId>
# [optional] [server]
SENTRY_DSN=https://your-public-key@app.glitchtip.com/your-project-id

# --- Environment & release tagging ------------------------------------------

# Human-readable label for the deployment environment.
# Appears on every event in GlitchTip so you can filter by environment.
# Common values: production | staging | development
# Falls back to "development" when not set.
# [optional] [server] (used by server + edge configs)
SENTRY_ENVIRONMENT=development

# Same environment label exposed to the browser SDK.
# Should match SENTRY_ENVIRONMENT.
# [optional] [public]
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Release identifier attached to every captured event.
# Typically the Git SHA or semantic version of the deployed build.
# Enables "Suspect Commits" and regression detection in GlitchTip.
# Example: 1.2.3  or  git-$(git rev-parse --short HEAD)
# [optional] [server]
SENTRY_RELEASE=

# Same release identifier exposed to the browser SDK.
# Should match SENTRY_RELEASE.
# [optional] [public]
NEXT_PUBLIC_SENTRY_RELEASE=

# --- Build-time / source-map upload variables --------------------------------
# These variables are consumed by the @sentry/nextjs webpack plugin during
# `next build`.  They do NOT need to be present at runtime — only in the
# environment where the production build is executed (e.g. CI).

# Base URL of your GlitchTip instance.
# The Sentry webpack plugin posts release artifacts and source maps here.
# Must be set to your GlitchTip deployment URL; defaults to https://sentry.io
# when omitted (which will fail for a self-hosted GlitchTip).
# Example: https://app.glitchtip.com
# [optional — but required for source-map upload to work] [build]
SENTRY_URL=https://app.glitchtip.com

# GlitchTip organisation slug.
# Found in GlitchTip → Settings → Organisation.
# [optional — but required for source-map upload to work] [build]
SENTRY_ORG=your-glitchtip-org-slug

# GlitchTip project slug.
# Found in GlitchTip → Settings → Projects.
# [optional — but required for source-map upload to work] [build]
SENTRY_PROJECT=your-glitchtip-project-slug

# GlitchTip API auth token used by the webpack plugin to authenticate source-
# map uploads and release creation.
# Create one at GlitchTip → User Settings → Auth Tokens with the
# project:write scope, then inject it as a CI secret (never hard-code it here).
# [optional — but required for source-map upload to work] [build]
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# --- Application version (public) -------------------------------------------

# Semantic version string (e.g. "1.2.3") surfaced to the browser.
# Can be read by client-side code to display the running version in the UI or
# to tag Sentry events with a human-friendly version label.
# Typically set by CI using the value from package.json or a Git tag.
# [optional] [public]
NEXT_PUBLIC_APP_VERSION=0.0.0
